  "sentences": [
    {
      "id": "s01",
      "ja": "青森県の沖で、マグニチュード7.5の強い地震がありました。",
      "en": "A strong magnitude 7.5 earthquake struck off Aomori Prefecture.",
      "zhHant": "青森縣外海發生7.5級強烈地震。",
      "speechJa": "あおもりけんの沖で、マグニチュードななてんごの強いじしんがありました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-01-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-01-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s02",
      "ja": "海岸に近い地域では、住民が高い場所へ避難しました。",
      "en": "In coastal areas, residents evacuated to higher ground.",
      "zhHant": "沿岸地區居民疏散到較高地勢。",
      "speechJa": "海岸に近い地域では、住民が高い場所へひなんしました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-02-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-02-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s03",
      "ja": "自治体は、けが人や建物の被害を確認しています。",
      "en": "Local authorities are checking for injuries and damage to buildings.",
      "zhHant": "地方政府正確認傷者人數與建築物受損情況。",
      "speechJa": "じちたいは、けが人や建物のひがいを確認しています。",
      "tokens": [],
      "audio": {
        "file": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-03-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-03-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s04",
      "ja": "鉄道の一部は、安全を調べるため運転を見合わせました。",
      "en": "Some railway services were suspended while safety checks were carried out.",
      "zhHant": "部分鐵路服務暫停，以進行安全檢查。",
      "speechJa": "てつどうの一部は、安全を調べるため運転を見合わせました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-04-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-04-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s05",
      "ja": "専門家は、しばらくの間、強い揺れに注意するよう呼びかけています。",
      "en": "Experts are urging people to remain alert for strong shaking for some time.",
      "zhHant": "專家呼籲民眾在未來一段時間繼續提防強烈震動。",
      "speechJa": "専門家は、しばらくの間、強いゆれに注意するよう呼びかけています。",
      "tokens": [],
      "audio": {
        "file": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-05-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-05-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s06",
      "ja": "家族で避難場所と連絡方法を確認することが大切です。",
      "en": "Families are advised to confirm evacuation sites and ways to contact one another.",
      "zhHant": "家庭應預先確認避難地點與彼此聯絡的方法。",
      "speechJa": "家族でひなん場所とれんらくほうほうを確認することが大切です。",
      "tokens": [],
      "audio": {
        "file": "../audio/9993-aomori-earthquake-magnitude-7-5/KM-NEWS-9993-aomori-earthquake-magnitude-7-5-sentence-06-ja-Nanami.mp3",
