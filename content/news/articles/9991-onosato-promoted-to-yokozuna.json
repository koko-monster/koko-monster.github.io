  "sentences": [
    {
      "id": "s01",
      "ja": "大の里は、相撲でいちばん高い地位、横綱になりました。",
      "en": "Ōnosato has reached yokozuna, the highest rank in sumo.",
      "zhHant": "大之里晉升為相撲最高級別「橫綱」。",
      "speechJa": "おおのさとは、相撲でいちばん高い地位、よこづなになりました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-01-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-01-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s02",
      "ja": "横綱になることが決まると、使者が部屋を訪れました。",
      "en": "After the promotion was decided, messengers visited his sumo stable.",
      "zhHant": "晉升決定後，使者到訪其相撲部屋。",
      "speechJa": "よこづなになることが決まると、ししゃが部屋を訪れました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-02-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-02-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s03",
      "ja": "大の里は、謹んでお受けしますと答えました。",
      "en": "Ōnosato replied, “I humbly accept.”",
      "zhHant": "大之里回應道：「我謹此接受。」",
      "speechJa": "おおのさとは、つつしんでお受けしますと答えました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-03-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-03-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s04",
      "ja": "そして、横綱として責任ある行動をすると誓いました。",
      "en": "He then pledged to act responsibly as a yokozuna.",
      "zhHant": "他並承諾，將以橫綱身分負責任地行事。",
      "speechJa": "そして、よこづなとしてせきにんある行動をすると誓いました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-04-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-04-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s05",
      "ja": "地元の人たちは、昇進を喜び、大きな拍手を送りました。",
      "en": "People in his home region celebrated the promotion with loud applause.",
      "zhHant": "家鄉民眾為他的晉升喝采，送上熱烈掌聲。",
      "speechJa": "地元の人たちは、しょうしんを喜び、大きな拍手を送りました。",
      "tokens": [],
      "audio": {
        "file": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-05-ja-Nanami.mp3",
        "voice": "ja-JP-NanamiNeural",
        "timings": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-05-ja-Nanami-timings.json"
      }
    },
    {
      "id": "s06",
      "ja": "これからの土俵での活躍に、注目が集まります。",
      "en": "Attention now turns to how he will perform in the ring.",
      "zhHant": "外界正期待他今後在土俵上的表現。",
      "speechJa": "これからのどひょうでの活躍に、注目が集まります。",
      "tokens": [],
      "audio": {
        "file": "../audio/9991-onosato-promoted-to-yokozuna/KM-NEWS-9991-onosato-promoted-to-yokozuna-sentence-06-ja-Nanami.mp3",
